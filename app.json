{
  "expo": {
    "name": "Ronda",
    "slug": "ronda-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#14141f"
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.ronda.app",
      "adaptiveIcon": {
        "backgroundColor": "#14141f"
      },
      "permissions": ["android.permission.POST_NOTIFICATIONS"]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#d4a338",
          "mode": "production"
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {}
    }
  }
}
